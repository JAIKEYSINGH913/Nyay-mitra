# NYAY-MITRA ENVIRONMENT CONFIGURATION (TEMPLATE)
# Duplicate this file to .env and fill in the values.

# NEO4J (Graph Database)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# APPWRITE (Auth & Storage)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# AI & LLM
GOOGLE_API_KEY=your-google-api-key
SARVAM_API_KEY=your-sarvam-api-key
JWT_SECRET_KEY=generate-a-secure-32-byte-key

# VECTOR DB (Milvus/Zilliz)
MILVUS_URI=https://your-milvus-instance.zilliz.com
MILVUS_TOKEN=your-token
MILVUS_COLLECTION=nyay_statues

# INFRASTRUCTURE
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
